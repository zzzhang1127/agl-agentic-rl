+        metrics["training/dynamic_sampling/enabled"] = int(enabled)
+        metrics["training/dynamic_sampling/gen_rounds"] = n_rounds
+        metrics["training/dynamic_sampling/n_rows_seen"] = n_rows_seen
+        metrics["training/dynamic_sampling/n_rows_discarded_zero_adv"] = n_rows_discarded
+        metrics["training/dynamic_sampling/n_groups_seen"] = n_groups_seen
+        metrics["training/dynamic_sampling/n_groups_zero_adv"] = n_groups_zero_adv
+        metrics["training/dynamic_sampling/n_groups_valid"] = n_groups_valid
+
+        if not kept_parts:
+            return None
+        if len(kept_parts) == 1:
+            return kept_parts[0]
