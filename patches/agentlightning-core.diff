+        rounds have been spent.  Returns ``None`` when nothing survives.
+        """
+        enabled, max_gen_batches, min_valid_groups = self._dynamic_sampling_config()
+        kept_parts: list[DataProto] = []
+        agent_metrics: dict[str, Any] = {}
+        n_rounds = 0
+        n_rows_seen = 0
+        n_rows_discarded = 0
+        n_groups_seen = 0
+        n_groups_zero_adv = 0
+        n_groups_valid = 0
