+                "the model server. Check the agl-server log for 503/502 on /proxy/rollout/... "
+                "(model name registered by the trainer vs default_proxy.model_name) before retrying."
+            )
+        print(f"{label}: {tally}")
+        raw = os.environ.get("AGL_MIN_CAPTURE_RATE")
+        threshold = float(raw) if raw else 0.0
+        if tally.rate < max(threshold, 0.9):
+            print(
+                f"{label}: WARNING capture rate {tally.rate:.1%} — "
+                f"{tally.calls - tally.kept} of {tally.calls} LLM calls never reached the batch"
+            )
