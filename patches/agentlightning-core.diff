+                n_groups_zero_adv += n_zero
+                n_groups_valid += n_groups - n_zero
+                n_rows_discarded += len(round_batch) - len(keep)
+                if keep:
+                    kept_parts.append(round_batch[keep] if len(keep) < len(round_batch) else round_batch)
+                print(
+                    f"AgentLightningRayPPOTrainer: dynamic sampling round {n_rounds}/{max_gen_batches}: "
+                    f"{n_groups - n_zero}/{n_groups} groups with reward variance, "
+                    f"{len(keep)}/{len(round_batch)} rows kept; valid groups so far {n_groups_valid}/{min_valid_groups}"
+                )
