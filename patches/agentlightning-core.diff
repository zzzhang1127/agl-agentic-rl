+    def _report_capture(self, label: str) -> None:
+        """Print this batch's capture rate, and stop the run if it is too low.
+
+        ``AGL_MIN_CAPTURE_RATE`` is unset by default, so this only warns; set it
+        (e.g. ``0.9``) for a smoke run that should refuse to train on a batch
+        that is mostly missing.
+        """
+        tally = self._capture
+        if tally is None or not tally.calls:
+            # Every rollout finished without a single model_request event: the agents never
+            # reached the model (e.g. the gateway answered 503 "No servers available" because
+            # the registered model name did not match). Training on this batch would be
+            # training on nothing, so fail loudly with the actual cause instead of AttributeError.
