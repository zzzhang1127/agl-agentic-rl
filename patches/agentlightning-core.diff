+_TOKENIZERS: dict[str, Any] = {}
+
+
+def _assistant_text(choice: dict[str, Any]) -> str:
+    """Reconstructed assistant text — approximate, and only a fallback.
+
+    The tool parser strips the tool-call block out of ``content``, so returning
+    ``content`` alone drops the action and keeps just the ``<think>`` prefix
+    (docs §41.3b: 59 tokens became 17). Concatenate instead of choosing. The
+    exact ids come from the logprobs path; this runs only when that is absent.
+    """
+    message = choice.get("message")
+    if not isinstance(message, dict):
+        return ""
+    parts: list[str] = []
+    content = message.get("content")
+    if isinstance(content, str) and content:
+        parts.append(content)
+    else:
+        reasoning = message.get("reasoning_content") or message.get("reasoning")
+        if isinstance(reasoning, str) and reasoning:
+            parts.append(reasoning)
+    tool_calls = message.get("tool_calls")
+    if tool_calls:
+        parts.append(_render_tool_calls_xml(tool_calls))
+    return "\n".join(parts)
+
+
+def _render_tool_calls_xml(tool_calls: Any) -> str:
+    """Render tool_calls back into the surface form MiniCPM5 actually emits.
+
+    The chat template writes assistant tool calls as
+    ``<function name="f"><param name="k">v</param></function>`` (chat_template.jinja
+    :135-148), and the parser reads that same shape back
+    (minicpm5xml_tool_parser.py:315). Dumping JSON here would put text in the
+    trajectory that the model never produced. Falls back to JSON only if the
+    structure is not what we expect.
+    """
+    try:
+        blocks: list[str] = []
+        for call in tool_calls:
+            fn = call.get("function", call) if isinstance(call, dict) else None
+            if not isinstance(fn, dict):
+                raise ValueError("tool_call has no function object")
+            name = fn["name"]
+            raw_args = fn.get("arguments", "")
+            args = json.loads(raw_args) if isinstance(raw_args, str) and raw_args else raw_args
+            if not isinstance(args, dict):
+                raise ValueError("arguments is not an object")
+            body = []
+            for key, value in args.items():
+                text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
+                # Same CDATA rule as the template, so the round trip matches.
+                if isinstance(value, str) and ("<" in value or "&" in value or "\n" in value):
+                    text = f"<![CDATA[{text}]]>"
+                body.append(f'<param name="{key}">{text}</param>')
+            blocks.append(f'<function name="{name}">' + "".join(body) + "</function>")
+        return "\n".join(blocks)
+    except Exception:
+        _bump("tool_call_xml_render_failed")
+        return json.dumps(tool_calls, ensure_ascii=False)
+
+
+_TOKEN_ID_PREFIX = "token_id:"
+
+# Every degraded branch below used to be silent. 92% of turns died in one of them
+# and nothing counted it (docs §41.4). Counting is what makes them visible.
+_CAPTURE_STATS: dict[str, int] = defaultdict(int)
+
+
+def capture_stats() -> dict[str, int]:
+    """Snapshot of the degradation counters, for the trainer's pre-flight check."""
+    return dict(_CAPTURE_STATS)
+
+
+def _bump(branch: str, **fields: Any) -> None:
+    _CAPTURE_STATS[branch] += 1
+    count = _CAPTURE_STATS[branch]
+    if count <= 3 or count % 200 == 0:
+        log.warning("token-id capture degraded", branch=branch, count=count, **fields)
+
+
+def _response_ids_from_logprobs(choice: dict[str, Any]) -> list[int] | None:
+    """Exact sampled ids, courtesy of ``return_tokens_as_token_ids``.
+
+    vLLM writes each token as the literal ``token_id:<id>`` (serving_engine.py:535).
+    Bail out wholesale on the first token that is not in that form — a partially
+    decoded list would be worse than falling back to the tokenizer.
+    """
+    logprobs = choice.get("logprobs")
+    if not isinstance(logprobs, dict):
+        return None
+    items = logprobs.get("content")
+    if not isinstance(items, list) or not items:
+        return None
+    ids: list[int] = []
+    for item in items:
+        token = item.get("token") if isinstance(item, dict) else None
+        if not isinstance(token, str) or not token.startswith(_TOKEN_ID_PREFIX):
+            return None
+        try:
+            ids.append(int(token[len(_TOKEN_ID_PREFIX) :]))
+        except ValueError:
+            return None
+    return ids
+
+
+def _check_against_usage(response_body: dict[str, Any], prompt_ids: list[int], response_ids: list[int]) -> None:
+    """vLLM already told us both lengths for free; disagreeing with it is a bug.
+
+    This is the check that would have caught §41.3b on day one — the stub kept
+    17 of the 59 tokens the server reported.
+    """
+    usage = response_body.get("usage")
+    if not isinstance(usage, dict):
+        return
+    for name, ids, key in (
+        ("prompt", prompt_ids, "prompt_tokens"),
+        ("response", response_ids, "completion_tokens"),
+    ):
+        expected = usage.get(key)
+        if not isinstance(expected, int) or expected <= 0 or not ids:
+            continue
+        # A couple of tokens of slack for special-token bookkeeping; a real
+        # mismatch (a dropped tool call, a rebuilt template) is far larger.
+        if abs(len(ids) - expected) > max(2, expected // 20):
+            _bump(f"{name}_length_mismatch", got=len(ids), expected=expected)
+
+
+def _fill_missing_token_ids(*, request_body: dict[str, Any], response_body: dict[str, Any], model_name: str) -> None:
+    """vLLM 0.8.x ignores return_token_ids; GRPO still needs prompt/response ids."""
+    choices = response_body.get("choices")
+    if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
+        return
+    prompt_ids = response_body.get("prompt_token_ids") or choices[0].get("prompt_token_ids") or []
+    response_ids = choices[0].get("token_ids") or []
+
+    # Prefer the server's own ids: no chat template, so neither the tool-call
+    # template crash (§41.3) nor the stripped-content truncation (§41.3b) applies.
+    if not response_ids:
+        exact = _response_ids_from_logprobs(choices[0])
+        if exact:
+            response_ids = exact
+            choices[0]["token_ids"] = exact
+        else:
+            _bump("no_token_ids_in_logprobs")
+
+    if prompt_ids and response_ids:
+        _check_against_usage(response_body, prompt_ids, response_ids)
+        return
+
+    try:
+        filled_prompt, filled_response, strategy = _tokenize_chat(model_name, request_body, choices[0])
+    except Exception as exc:
+        _bump("tokenize_failed", error=str(exc))
+        log.warning("token-id backfill failed", model=model_name, error=str(exc))
+        return
+    if strategy != "as-is":
+        _bump(f"tokenize_via_{strategy}")
+    if not prompt_ids:
+        prompt_ids = filled_prompt
+        response_body["prompt_token_ids"] = filled_prompt
+    if not response_ids:
+        response_ids = filled_response
+        choices[0]["token_ids"] = filled_response
+    _check_against_usage(response_body, prompt_ids, response_ids)
+    log.info(
+        "token-id backfill",
+        model=model_name,
+        strategy=strategy,
+        prompt_tokens=len(prompt_ids),
+        response_tokens=len(response_ids),
+    )
+
+
+def _to_int_ids(raw: Any) -> list[int]:
+    if hasattr(raw, "tolist"):
+        raw = raw.tolist()
+    if not isinstance(raw, list):
+        raise TypeError(f"tokenizer returned {type(raw).__name__}, expected list[int]")
+    return [int(x) for x in raw]
+
+
+def _tokenize_chat(
+    model_name: str, request_body: dict[str, Any], choice: dict[str, Any]
+) -> tuple[list[int], list[int], str]:
+    tokenizer = _TOKENIZERS.get(model_name)
+    if tokenizer is None:
+        from transformers import AutoTokenizer
+
+        tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)
+        _TOKENIZERS[model_name] = tokenizer
+    messages = request_body.get("messages") or []
+    tools = request_body.get("tools")
+    # extra_body keys land at the top level of the request body, so this is where
+    # the client's chat_template_kwargs arrive.
+    prompt_ids, strategy = _apply_chat_template(
+        tokenizer, messages, tools, request_body.get("chat_template_kwargs")
+    )
+    response_ids = tokenizer.encode(_assistant_text(choice), add_special_tokens=False)
+    return prompt_ids, _to_int_ids(response_ids), strategy
+
+
+def _coerce_tool_call_arguments(messages: list[Any]) -> list[Any]:
+    """Turn ``function.arguments`` from a JSON string into a mapping.
+
+    The wire format specifies a string, but MiniCPM5's template calls
+    ``.items()`` on it, so every message carrying a prior tool call raises
+    ``UndefinedError`` and the whole turn is dropped (docs §41.3).
+    """
+    out: list[Any] = []
+    changed = False
+    for message in messages:
+        calls = message.get("tool_calls") if isinstance(message, dict) else None
+        if not calls:
+            out.append(message)
+            continue
+        new_calls: list[Any] = []
+        for call in calls:
+            function = call.get("function") if isinstance(call, dict) else None
+            arguments = function.get("arguments") if isinstance(function, dict) else None
+            if isinstance(arguments, str):
+                try:
+                    parsed = json.loads(arguments)
+                except (json.JSONDecodeError, TypeError):
+                    parsed = None
+                if isinstance(parsed, dict):
+                    call = {**call, "function": {**function, "arguments": parsed}}
+                    changed = True
+            new_calls.append(call)
+        out.append({**message, "tool_calls": new_calls})
+    return out if changed else messages
+
+
+def _inline_tool_calls(messages: list[Any]) -> list[Any]:
+    """Last resort: render tool calls into the text and drop the structured field.
+
+    A truncated generation leaves ``arguments`` as unparseable JSON, so coercing
+    it is not an option and the template still crashes on it. The rendered prompt
+    is then only an approximation of what the server saw — the usage cross-check
+    flags that — but an approximate turn beats a dropped one.
+    """
+    out: list[Any] = []
+    changed = False
+    for message in messages:
+        calls = message.get("tool_calls") if isinstance(message, dict) else None
+        if not calls:
+            out.append(message)
+            continue
+        text = message.get("content")
+        rendered = json.dumps(calls, ensure_ascii=False, default=str)
+        merged = f"{text}\n{rendered}" if isinstance(text, str) and text else rendered
+        out.append({k: v for k, v in message.items() if k != "tool_calls"} | {"content": merged})
+        changed = True
+    return out if changed else messages
+
+
+def _apply_chat_template(
+    tokenizer: Any, messages: list[Any], tools: Any, template_kwargs: Any = None
+) -> tuple[list[int], str]:
+    """As-is, then with coerced arguments, then without tools.
+
+    Templates fail with whatever their jinja happens to raise (``TypeError``,
+    ``UndefinedError``, ...), so each rung catches broadly and the last one
+    re-raises rather than returning a silently empty prompt.
+
+    ``template_kwargs`` is the request's own ``chat_template_kwargs``. It has to be
+    forwarded: the prompt we render here is what the *trainer* learns on, while the
+    prompt the policy actually generated from was rendered by vLLM **with** those
+    kwargs. Dropping them makes the two renders differ, and for MiniCPM5 the
+    difference is 4 tokens -- ``enable_thinking=False`` makes the template emit
+    ``<think>\\n\\n</think>\\n\\n`` at the generation position (chat_template.jinja:168).
+    Those 4 tokens broke the turn-to-turn prefix chain in
+    ``rollout_adapter.py:756``, so every turn of every episode was flushed as its own
+    training row carrying the episode-final reward: multi-turn credit assignment never
+    ran once across s1/s2/s3. Measured 10-05: n_unmerged_rollouts 64/64 every step,
+    22.1M forward tokens instead of 1.2M (18.3x). See docs/pitfalls-and-lessons.md §56.
+    """
+    base: dict[str, Any] = {"tokenize": True, "add_generation_prompt": True}
+    if isinstance(template_kwargs, dict) and template_kwargs:
+        base.update(template_kwargs)
+    with_tools = dict(base)
+    if tools:
+        with_tools["tools"] = tools
+
+    attempts: list[tuple[str, list[Any], dict[str, Any]]] = [("as-is", messages, with_tools)]
+    coerced = _coerce_tool_call_arguments(messages)
+    if coerced is not messages:
+        attempts.append(("args_dict", coerced, dict(with_tools)))
+    attempts.append(("no_tools", coerced, base))
+    inlined = _inline_tool_calls(coerced)
+    if inlined is not coerced:
+        attempts.append(("inlined_tool_calls", inlined, dict(with_tools)))
+        attempts.append(("inlined_no_tools", inlined, base))
+
+    last_error: Exception | None = None
+    for strategy, msgs, kwargs in attempts:
+        try:
+            prompt_ids = tokenizer.apply_chat_template(msgs, **kwargs)
+        except Exception as exc:
+            last_error = exc
+            continue
+        if isinstance(prompt_ids, str):
+            prompt_ids = tokenizer.encode(prompt_ids, add_special_tokens=False)
+        return _to_int_ids(prompt_ids), strategy
+    assert last_error is not None
+    raise last_error
+
