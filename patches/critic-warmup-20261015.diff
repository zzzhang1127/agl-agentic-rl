index 0000000..86a89ab
--- /dev/null
+++ b/agentlightning/verl/critic_freeze.py
@@ -0,0 +1,65 @@
+# Copyright (c) Microsoft. All rights reserved.
+
+"""Auditable, pre-sharding attention freezing for a Llama-style value model.
+
+This implements the user's freeze requirement, not the unverified SAO training
+recipe. Call before optimizer construction and FSDP wrapping; mixed frozen and
+trainable parameters require use_orig_params=True with FSDP1.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+
+def freeze_llama_critic_attention(model: Any) -> dict[str, Any]:
+    """Freeze only attention parameters after validating every configured layer.
+
+    Never use no_grad around attention forwards: gradients must still propagate
+    through attention to trainable earlier MLPs. Unknown architectures and shared
+    attention/MLP parameters fail closed instead of partially freezing a model.
+    """
+    config = model.config
+    if getattr(config, "model_type", None) != "llama":
+        raise ValueError("attention freeze currently supports only verified Llama-style critics")
+    layer_count = getattr(config, "num_hidden_layers", None)
+    if type(layer_count) is not int or layer_count <= 0:
+        raise ValueError("invalid critic layer count")
+    backbone = getattr(model, "model", None)
+    layers = getattr(backbone, "layers", None)
+    if layers is None or len(layers) != layer_count:
+        raise ValueError("critic layers do not match model configuration")
+    attention_ids = set()
+    for layer in layers:
+        attention = getattr(layer, "self_attn", None)
+        if attention is None:
+            raise ValueError("critic layer missing self_attn")
+        for projection in ("q_proj", "k_proj", "v_proj", "o_proj"):
+            if getattr(attention, projection, None) is None:
+                raise ValueError(f"attention missing {projection}")
+        parameters = list(attention.parameters())
+        if not parameters:
+            raise ValueError("attention has no parameters")
+        attention_ids.update(id(p) for p in parameters)
+    named = list(model.named_parameters(remove_duplicate=False))
+    for name, parameter in named:
+        if getattr(parameter, "_is_flat_param", False):
+            raise ValueError("freeze must run before FSDP parameter flattening")
+        if id(parameter) in attention_ids and ".self_attn." not in name:
+            raise ValueError("attention parameter shared with non-attention module")
+    if not any(p.requires_grad and id(p) not in attention_ids for _, p in named):
+        raise ValueError("no trainable non-attention critic parameters")
+    for _, parameter in named:
+        if id(parameter) in attention_ids:
+            parameter.requires_grad_(False)
+            parameter.grad = None
+    # Count unique parameters, while preserving all names for auditing aliases.
+    unique = {id(p): p for _, p in named}
+    return {
+        "model_type": "llama",
+        "attention_layers": layer_count,
+        "frozen_attention_names": [n for n, p in named if id(p) in attention_ids],
+        "trainable_names": [n for n, p in named if p.requires_grad],
+        "frozen_attention_numel": sum(p.numel() for key, p in unique.items() if key in attention_ids),
