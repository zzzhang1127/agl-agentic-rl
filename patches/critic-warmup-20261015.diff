+# Copyright (c) Microsoft. All rights reserved.
+
+"""Validate an explicitly selected, complete critic-only checkpoint."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import re
+
+
+def validate_critic_checkpoint(
+    path: str, *, world_size: int, model_path: str
+) -> tuple[int, str, str]:
+    """Reject partial saves and incompatible model shapes before loading workers."""
+    if not isinstance(path, str) or not Path(path).is_absolute():
+        raise ValueError("critic resume requires an explicit absolute checkpoint path")
+    if type(world_size) is not int or world_size < 1:
+        raise ValueError("invalid critic resume world size")
+    folder = Path(path)
+    match = re.fullmatch(r"global_step_([0-9]+)", folder.name)
+    if not match or not folder.is_dir():
+        raise ValueError("critic resume requires a published global_step_N directory")
+    critic = folder / "critic"
+    required = [critic / f"{kind}_world_size_{world_size}_rank_{rank}.pt"
+                for kind in ("model", "optim", "extra_state") for rank in range(world_size)]
+    required += [folder / "data.pt", critic / "huggingface" / "config.json"]
+    if any(not item.is_file() or item.stat().st_size == 0 for item in required):
+        raise ValueError("critic checkpoint is missing model, optimizer, extra, or dataloader state")
+    saved = json.loads((critic / "huggingface" / "config.json").read_text())
+    expected = json.loads((Path(model_path) / "config.json").read_text())
+    for key in ("model_type", "hidden_size", "num_hidden_layers", "vocab_size",
+                "num_attention_heads", "num_key_value_heads"):
+        if key not in expected or saved.get(key) != expected[key]:
+            raise ValueError(f"critic checkpoint model mismatch: {key}")
+    return int(match.group(1)), str(critic), str(folder / "data.pt")
