+# Copyright (c) Microsoft. All rights reserved.
+
+"""Keep runtime credentials out of experiment tracking configuration."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def redact_tracking_config(value: Any) -> Any:
+    """Return a separate logging tree; the live training config stays intact."""
+    secret_keys = {
+        "agl_key", "api_key", "service_key", "password", "authorization",
+        "access_token", "refresh_token", "secret", "client_secret", "swanlab_api_key",
+    }
+    if isinstance(value, dict):
+        return {
+            key: "<redacted>" if isinstance(key, str) and key.lower() in secret_keys
+            else redact_tracking_config(item)
+            for key, item in value.items()
+        }
+    if isinstance(value, list):
+        return [redact_tracking_config(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(redact_tracking_config(item) for item in value)
+    return value
