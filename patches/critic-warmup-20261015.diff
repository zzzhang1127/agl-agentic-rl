+    """Import hook used by Ray actor processes.
+
+    Records the RMS change of a local parameter sample around each optimizer
+    step. The training driver watches ``WEIGHT_DELTA`` and raises the learning
+    rate when the gradient is nonzero but the weights barely move.
+    """
+    from verl.workers.actor.dp_actor import DataParallelPPOActor
+
+    if getattr(DataParallelPPOActor, "_weight_delta_wrapped", False):
+        return
+
+    original = DataParallelPPOActor._optimizer_step
+
+    def _flat_head(tensor, n: int):
+        if hasattr(tensor, "to_local"):
+            tensor = tensor.to_local()
+        flat = tensor.detach().reshape(-1)
+        return flat[:n].float().cpu().clone()
+
+    def _snap(actor, n: int = 2048):
+        chunks = []
+        seen = 0
+        for param in actor.actor_module.parameters():
+            if param.numel() == 0:
+                continue
+            chunks.append(_flat_head(param.data, n - seen))
+            seen += chunks[-1].numel()
+            if seen >= n:
+                break
+        return chunks
+
+    def _rms(before, after) -> float:
+        if not before or len(before) != len(after):
+            return float("nan")
+        total = 0.0
+        count = 0
+        for left, right in zip(before, after):
+            if left.numel() != right.numel():
+                return float("nan")
+            total += float((left - right).pow(2).sum())
+            count += left.numel()
+        if count == 0:
+            return float("nan")
+        return (total / count) ** 0.5
+
+    def _optimizer_step(self):
+        try:
+            before = _snap(self)
+        except Exception:
+            before = []
+        grad_norm = original(self)
+        try:
+            delta = _rms(before, _snap(self))
+        except Exception:
+            delta = float("nan")
+        self._last_param_rms_delta = delta
+        print(
+            f"WEIGHT_DELTA param_rms={delta:.3e} grad_norm={float(grad_norm):.3e}",
+            flush=True,
+        )
+        return grad_norm
+
+    DataParallelPPOActor._optimizer_step = _optimizer_step
+    DataParallelPPOActor._weight_delta_wrapped = True
