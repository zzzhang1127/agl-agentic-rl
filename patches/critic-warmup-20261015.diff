+_TOKENIZERS: dict[str, Any] = {}
+
+
+def _assistant_text(choice: dict[str, Any]) -> str:
+    message = choice.get("message")
+    if not isinstance(message, dict):
+        return ""
+    content = message.get("content")
+    if isinstance(content, str) and content:
+        return content
+    reasoning = message.get("reasoning_content") or message.get("reasoning")
+    if isinstance(reasoning, str) and reasoning:
+        return reasoning
+    tool_calls = message.get("tool_calls")
+    if tool_calls:
+        return json.dumps(tool_calls, ensure_ascii=False)
+    return content if isinstance(content, str) else ""
+
+
+def _parse_sampled_token_id(token: str) -> int:
+    if not token.startswith("token_id:"):
+        raise ValueError("training completion is missing explicit sampled token IDs")
+    suffix = token[len("token_id:") :]
+    if not suffix.isascii() or not suffix.isdecimal():
+        raise ValueError("invalid sampled token ID")
+    return int(suffix)
+
+
+def _sampled_token_ids(choice: dict[str, Any]) -> list[int]:
+    """Read vLLM's sampled IDs, never re-encode parsed assistant/tool text."""
+    entries = (choice.get("logprobs") or {}).get("content")
+    if not isinstance(entries, list) or not entries:
+        raise ValueError("training completion is missing sampled-token logprobs")
+    ids = []
+    for entry in entries:
+        token = entry.get("token") if isinstance(entry, dict) else None
+        if not isinstance(token, str):
+            raise ValueError("training completion is missing explicit sampled token IDs")
+        ids.append(_parse_sampled_token_id(token))
+    existing = choice.get("token_ids")
+    if existing is not None and existing != ids:
+        raise ValueError("sampled token IDs disagree with completion token IDs")
+    return ids
+
+
+def _token_ids_from_vocab_logprobs(choice: dict[str, Any], model_name: str) -> list[int]:
+    """Map vLLM logprob.content token strings to ids (vLLM 0.8.x without token_id: labels)."""
+    entries = (choice.get("logprobs") or {}).get("content")
+    if not isinstance(entries, list) or not entries:
+        raise ValueError("training completion is missing sampled-token logprobs")
+    tokenizer = _TOKENIZERS.get(model_name)
+    if tokenizer is None:
+        from transformers import AutoTokenizer
+
+        tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)
+        _TOKENIZERS[model_name] = tokenizer
+    unk_id = getattr(tokenizer, "unk_token_id", None)
+    ids: list[int] = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError("malformed logprob entry")
+        token = entry.get("token")
+        if not isinstance(token, str) or not token:
+            raise ValueError("malformed logprob token")
+        token_id = tokenizer.convert_tokens_to_ids(token)
+        if token_id is None or not isinstance(token_id, int):
+            raise ValueError(f"tokenizer could not map logprob token {token!r}")
+        if unk_id is not None and token_id == unk_id:
+            raise ValueError(f"tokenizer mapped logprob token {token!r} to unk")
+        ids.append(int(token_id))
+    return ids
+
+
+def _behavior_logprob_token_ids(choice: dict[str, Any], model_name: str) -> list[int]:
+    """Token ids in the same order and length as logprobs.content (behavior policy)."""
+    entries = (choice.get("logprobs") or {}).get("content")
+    if not isinstance(entries, list) or not entries:
+        raise ValueError("training completion is missing sampled-token logprobs")
+    tokens = [entry.get("token") if isinstance(entry, dict) else None for entry in entries]
+    if all(isinstance(token, str) and token.startswith("token_id:") for token in tokens):
+        return _sampled_token_ids(choice)
+    if any(isinstance(token, str) and token.startswith("token_id:") for token in tokens):
+        raise ValueError("mixed token_id and vocab logprob tokens in one completion")
+    ids = _token_ids_from_vocab_logprobs(choice, model_name)
+    existing = choice.get("token_ids")
+    if existing is not None and existing != ids:
+        log.warning(
+            "replacing mismatched completion token_ids with behavior logprob ids",
+            model=model_name,
+            old_len=len(existing),
+            new_len=len(ids),
+        )
+    return ids
+
+
+def _training_expects_behavior_logprobs(request_body: dict[str, Any]) -> bool:
+    return request_body.get("return_tokens_as_token_ids") is True or request_body.get("logprobs") is True
+
+
+def _fill_missing_token_ids(*, request_body: dict[str, Any], response_body: dict[str, Any], model_name: str) -> None:
+    """Align response token ids with behavior logprobs; never re-encode parsed tool JSON for training."""
+    choices = response_body.get("choices")
+    if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
+        return
+
+    training = _training_expects_behavior_logprobs(request_body)
+    for choice in choices:
+        entries = (choice.get("logprobs") or {}).get("content")
+        if isinstance(entries, list) and entries:
+            choice["token_ids"] = _behavior_logprob_token_ids(choice, model_name)
+            continue
+        if training:
+            raise ValueError("training completion is missing sampled-token logprobs")
+
+    prompt_ids = response_body.get("prompt_token_ids") or choices[0].get("prompt_token_ids") or []
+    response_ids = choices[0].get("token_ids") or []
+    if prompt_ids and response_ids:
+        return
+    try:
+        filled_prompt, filled_response = _tokenize_chat(model_name, request_body, choices[0])
+    except Exception as exc:
+        log.warning("token-id backfill failed", model=model_name, error=str(exc))
+        return
+    if not prompt_ids:
+        response_body["prompt_token_ids"] = filled_prompt
+    if not response_ids:
+        choices[0]["token_ids"] = filled_response
+    log.info(
+        "token-id backfill",
+        model=model_name,
+        prompt_tokens=len(response_body.get("prompt_token_ids") or []),
+        response_tokens=len(choices[0].get("token_ids") or []),
+    )
+
+
+def _to_int_ids(raw: Any) -> list[int]:
+    if hasattr(raw, "tolist"):
+        raw = raw.tolist()
+    if not isinstance(raw, list):
+        raise TypeError(f"tokenizer returned {type(raw).__name__}, expected list[int]")
+    return [int(x) for x in raw]
+
+
+def _normalize_messages_for_template(messages: Any) -> list[Any]:
+    """Normalize OpenAI tool-call arguments for chat-template tokenization.
+
+    vLLM/OpenCode requests carry function.arguments as a JSON string, while the
+    MiniCPM chat template iterates over arguments.items().  Convert only valid
+    JSON-object argument strings; leave everything else unchanged so malformed
+    requests still fail instead of being silently rewritten.
+    """
+    if not isinstance(messages, list):
+        return []
+    normalized: list[Any] = []
+    for message in messages:
+        if not isinstance(message, dict):
+            normalized.append(message)
+            continue
+        msg = dict(message)
+        tool_calls = msg.get("tool_calls")
+        if isinstance(tool_calls, list):
+            fixed_calls: list[Any] = []
+            for call in tool_calls:
+                if not isinstance(call, dict):
+                    fixed_calls.append(call)
+                    continue
+                fixed = dict(call)
+                function = fixed.get("function")
+                if isinstance(function, dict):
+                    fixed_function = dict(function)
+                    arguments = fixed_function.get("arguments")
+                    if isinstance(arguments, str):
+                        try:
+                            parsed_arguments = json.loads(arguments)
+                        except json.JSONDecodeError:
+                            parsed_arguments = None
+                        if isinstance(parsed_arguments, dict):
+                            fixed_function["arguments"] = parsed_arguments
+                    fixed["function"] = fixed_function
+                fixed_calls.append(fixed)
+            msg["tool_calls"] = fixed_calls
+        normalized.append(msg)
+    return normalized
+
+
+def _tokenize_chat(model_name: str, request_body: dict[str, Any], choice: dict[str, Any]) -> tuple[list[int], list[int]]:
+    tokenizer = _TOKENIZERS.get(model_name)
+    if tokenizer is None:
+        from transformers import AutoTokenizer
+
+        tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)
+        _TOKENIZERS[model_name] = tokenizer
+    messages = _normalize_messages_for_template(request_body.get("messages") or [])
+    tools = request_body.get("tools")
+    kwargs: dict[str, Any] = {"tokenize": True, "add_generation_prompt": True}
+    if tools:
+        kwargs["tools"] = tools
+    try:
+        prompt_ids = tokenizer.apply_chat_template(messages, **kwargs)
+    except Exception as exc:
+        # Some chat templates expect OpenAI tool schemas, while OpenCode/vLLM may
+        # pass provider-specific tool metadata.  For training we need a stable
+        # prompt-token prefix; retry without tools instead of leaving empty ids.
+        if "tools" not in kwargs:
+            raise
+        log.warning("chat-template tokenization with tools failed; retrying without tools", model=model_name, error=str(exc))
+        kwargs.pop("tools", None)
+        prompt_ids = tokenizer.apply_chat_template(messages, **kwargs)
+    if isinstance(prompt_ids, str):
+        prompt_ids = tokenizer.encode(prompt_ids, add_special_tokens=False)
+    prompt_ids = _to_int_ids(prompt_ids)
+    response_ids = tokenizer.encode(_assistant_text(choice), add_special_tokens=False)
+    return prompt_ids, _to_int_ids(response_ids)
+
