+# Copyright (c) Microsoft. All rights reserved.
+
+"""Attention-frozen critic for the verified verl legacy FSDP1 builder."""
+from __future__ import annotations
+
+import json
+from threading import RLock
+from unittest.mock import patch
+
+from verl.workers.fsdp_workers import CriticWorker
+
+from .critic_freeze import freeze_llama_critic_attention
+
+_BUILD_LOCK = RLock()
+
+
+class AttentionFrozenCriticWorker(CriticWorker):
+    """Reuse upstream initialization, sharding, optimizer and checkpoint code.
+
+    verl 0.7.1 has no pre-FSDP model callback. Intercept its value-model loader
+    only during this synchronous builder, restoring it even on failure. Actor
+    loading does not use this value-head loader. Do not move freezing after the
+    parent builder: by then FSDP and the optimizer already exist.
+    """
+
+    def _build_critic_model_optimizer(self, config):
+        from importlib.metadata import version
+
+        from verl.utils import model as model_utils
+
+        if version("verl") != "0.7.1":
+            raise ValueError("attention-frozen worker requires verified verl 0.7.1")
+        if config.strategy != "fsdp":
+            raise ValueError("attention-frozen worker currently requires FSDP1")
+        if config.model.fsdp_config.get("use_orig_params", False) is not True:
+            raise ValueError("attention-frozen worker requires use_orig_params=True")
+        if config.model.get("lora_rank", 0) or config.model.get("lora_adapter_path"):
+            raise ValueError("attention-frozen worker does not support LoRA")
+
+        with _BUILD_LOCK:
+            original_loader = model_utils.load_valuehead_model
+            audits = []
+
+            def load_frozen_value_model(*args, **kwargs):
+                model = original_loader(*args, **kwargs)
+                audits.append(freeze_llama_critic_attention(model))
+                return model
+
+            with patch.object(model_utils, "load_valuehead_model", load_frozen_value_model):
+                result = super()._build_critic_model_optimizer(config)
+            if len(audits) != 1:
+                raise RuntimeError("upstream critic builder did not invoke exactly one value-model loader")
+            self.attention_freeze_audit = audits[0]
+            if self.rank == 0:
+                print("CRITIC_ATTENTION_FREEZE " + json.dumps(self.attention_freeze_audit), flush=True)
+            return result
