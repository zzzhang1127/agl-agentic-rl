+def _hmpo_rewards(resolved: list[bool], lengths: list[int], *, floor: float = 0.1) -> list[float]:
+    """Group-median HMPO: wrong=0; budget = median length of correct members.
+
+    Keep this identical to examples/swe_smith/hmpo_reward.py:hmpo_rewards.
+    Inlined so the trainer process does not import the examples tree.
+    """
+    if len(resolved) != len(lengths):
+        raise ValueError(f"resolved ({len(resolved)}) and lengths ({len(lengths)}) size mismatch")
+    if not resolved:
+        return []
+    correct_lengths = [max(int(length), 1) for flag, length in zip(resolved, lengths, strict=True) if flag]
+    if not correct_lengths:
+        return [0.0] * len(resolved)
+    budget = float(median(correct_lengths))
+    out: list[float] = []
+    for flag, length in zip(resolved, lengths, strict=True):
+        if not flag:
+            out.append(0.0)
+            continue
+        scale = budget / max(int(length), 1)
+        out.append(min(1.0, max(floor, scale)))
+    return out
+
+
+def apply_hmpo_to_completed(rollouts: list[CompletedRollout]) -> list[CompletedRollout]:
+    """Reshape rewards inside each data_id group when SMITH_HMPO=1.
+
+    Agent must post raw 0/1 (SMITH_HMPO=1 skips the global t0 ramp). This is the
+    trainer-side half: algorithm.hmpo in train_smith_agent.py is not read by VERL.
+    """
+    if not rollouts or not _hmpo_enabled():
+        return rollouts
+    groups: dict[str, list[int]] = {}
+    for index, rollout in enumerate(rollouts):
+        groups.setdefault(rollout.data_id, []).append(index)
+    new_rewards = [rollout.final_reward for rollout in rollouts]
+    for indices in groups.values():
+        resolved = [(rollouts[i].final_reward or 0.0) > 0.0 for i in indices]
+        lengths = [_rollout_n_turns(rollouts[i]) for i in indices]
+        reshaped = _hmpo_rewards(resolved, lengths)
+        for i, value in zip(indices, reshaped, strict=True):
+            new_rewards[i] = value
+    out: list[CompletedRollout] = []
+    for rollout, reward in zip(rollouts, new_rewards, strict=True):
+        updated = rollout.model_copy(update={"final_reward": reward})
+        if updated.triplets:
+            last = updated.triplets[-1].model_copy(update={"reward": reward})
+            updated.triplets = [*updated.triplets[:-1], last]
+        out.append(updated)
+    return out
