+# Copyright (c) Microsoft. All rights reserved.
+
+"""Explicit actor-update interlock for critic-only warmup runs."""
+from __future__ import annotations
+
+
+def actor_update_allowed(*, critic_only: bool, use_critic: bool, global_steps: int, critic_warmup: int) -> bool:
+    """A critic-only run never transitions to actor updates based on step count.
+
+    Advancing beyond this phase requires a separately validated configuration;
+    this function does not claim that a critic has passed quality validation.
+    """
+    if type(critic_only) is not bool or type(use_critic) is not bool:
+        raise ValueError("critic_only and use_critic must be booleans")
+    for name, value in (("global_steps", global_steps), ("critic_warmup", critic_warmup)):
+        if type(value) is not int or value < 0:
+            raise ValueError(f"{name} must be a nonnegative integer")
+    if critic_only and not use_critic:
+        raise ValueError("critic-only training requires an enabled critic")
+    return not critic_only and global_steps >= critic_warmup
