+def _atomic_replace_dir(tmp_dir: str, final_dir: str) -> None:
+    """Publish a finished checkpoint directory by renaming `*.tmp` over the live path."""
+    old_dir = final_dir + ".old"
+    if os.path.exists(old_dir):
