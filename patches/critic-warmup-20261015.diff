+# Copyright (c) Microsoft. All rights reserved.
+
+"""Fail-closed checks before constructing training tensors from rollout rewards."""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+
+
+def require_explicit_training_rewards(rollouts: list[Any], *, require_evaluator_approval: bool = False) -> None:
+    """Reject an entire batch rather than silently filling unavailable rewards.
+
+    This checks transport completeness, not grader correctness. GAE requires
+    explicit evaluator approval; legacy consumers may retain scalar-only rewards.
+    Approval metadata still needs a separately verified evaluator.
+    """
+    for rollout in rollouts:
+        reward = rollout.final_reward
+        if isinstance(reward, bool) or not isinstance(reward, (int, float)) or not math.isfinite(reward):
+            raise ValueError(f"rollout {rollout.rollout_id!r}: missing or non-finite training reward")
+        if rollout.error_message:
+            raise ValueError(f"rollout {rollout.rollout_id!r}: runner error makes reward unavailable")
+        approved_reward_seen = False
+        for event in rollout.triplet_events or []:
+            if not isinstance(event, dict):
+                raise ValueError(f"rollout {rollout.rollout_id!r}: malformed event")
+            if event.get("event_type") != "reward":
+                continue
+            data = event.get("data")
+            if not isinstance(data, dict):
+                raise ValueError(f"rollout {rollout.rollout_id!r}: malformed reward event")
+            if "reward_eligible" in data and data["reward_eligible"] is not True:
+                raise ValueError(f"rollout {rollout.rollout_id!r}: evaluator rejected training reward")
+            if require_evaluator_approval:
+                if data.get("reward_eligible") is not True or data.get("evaluation_state") != "complete":
+                    raise ValueError(f"rollout {rollout.rollout_id!r}: missing complete evaluator approval")
+                value = data.get("value")
+                if (isinstance(value, bool) or not isinstance(value, (int, float))
+                        or not math.isfinite(value) or value != reward):
+                    raise ValueError(f"rollout {rollout.rollout_id!r}: approved reward disagrees with final reward")
+                approved_reward_seen = True
+        if require_evaluator_approval and not approved_reward_seen:
+            raise ValueError(f"rollout {rollout.rollout_id!r}: missing complete evaluator approval")
+
+
+def split_explicit_training_rewards(
+    rollouts: list[Any],
+    *,
+    require_evaluator_approval: bool = False,
+) -> tuple[list[Any], list[tuple[str, str]]]:
+    """Partition rollouts into reward-safe rows and explicit rejection reasons.
+
+    SAO critic warmup must not train on unavailable or rejected rewards. A single
+    bad rollout should be dropped from the step, not converted into a fake zero
+    reward and not allowed to abort otherwise clean rollouts in the same batch.
+    """
+    accepted: list[Any] = []
+    rejected: list[tuple[str, str]] = []
+    for rollout in rollouts:
+        try:
+            require_explicit_training_rewards([rollout], require_evaluator_approval=require_evaluator_approval)
+        except ValueError as exc:
+            rejected.append((str(getattr(rollout, "rollout_id", "<unknown>")), str(exc)))
+        else:
+            accepted.append(rollout)
+    return accepted, rejected
+
+
+def require_token_logprob_alignment(rollout: Any) -> None:
+    """Reject rollouts whose stored ids are not aligned with behavior logprobs."""
+    for triplet in rollout.triplets or []:
+        response = triplet.response if hasattr(triplet, "response") else None
+        if not isinstance(response, dict):
+            raise ValueError(f"rollout {rollout.rollout_id!r}: malformed triplet response")
+        token_ids = response.get("token_ids", [])
+        log_probs = response.get("log_probs")
+        if not isinstance(token_ids, list) or not token_ids:
+            raise ValueError(f"rollout {rollout.rollout_id!r}: missing response token_ids")
+        if log_probs is None:
+            raise ValueError(f"rollout {rollout.rollout_id!r}: missing response log_probs for GAE")
+        if len(log_probs) != len(token_ids):
+            raise ValueError(
+                f"rollout {rollout.rollout_id!r}: token/logprob length mismatch "
+                f"({len(token_ids)} ids vs {len(log_probs)} logprobs)"
+            )
+
+
+def split_token_logprob_aligned_rollouts(rollouts: list[Any]) -> tuple[list[Any], list[tuple[str, str]]]:
+    accepted: list[Any] = []
+    rejected: list[tuple[str, str]] = []
+    for rollout in rollouts:
+        try:
+            require_token_logprob_alignment(rollout)
+        except ValueError as exc:
+            rejected.append((str(getattr(rollout, "rollout_id", "<unknown>")), str(exc)))
+        else:
+            accepted.append(rollout)
+    return accepted, rejected
