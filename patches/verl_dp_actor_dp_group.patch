+    def _dp_group(self):
+        """Process group across which rearrange_micro_batches must align its micro-batch count.
+
+        LOCAL PATCH (2026-10-03). Without this, prepare_dynamic_batch() runs with
+        dp_group=None, which silently disables the all_reduce(MAX) in
+        verl/utils/seqlen_balancing.py:402 -- that branch is gated on `dp_group is not None`,
+        NOT on `same_micro_num_in_dp` (which defaults to True and is misleading). Each DP rank
+        then derives num_micro_batches from its own shard's token total; the rank with fewer
+        micro-batches leaves the loop early and stops joining FSDP's per-layer
+        _ALLGATHER_BASE, so the rest busy-wait until nccl_timeout. Mirrors
+        FSDPEngine.get_data_parallel_group() (verl/workers/engine/fsdp/transformer_impl.py:558),
+        which the engine path already passes at transformer_impl.py:583.
+
+        With ulysses SP on we keep the old behaviour (None): the DP sub-group cannot be derived
+        from here, and this run uses sp=1.
+        """
+        if not torch.distributed.is_initialized() or self.use_ulysses_sp:
+            return None
+        return torch.distributed.group.WORLD
